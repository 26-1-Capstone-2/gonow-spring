### E-5. 이메일 중복 → 400 "이미 사용 중인 이메일입니다."
# 사전 조건: hero@cau.ac.kr 계정이 DB에 존재해야 함 (member.http의 1번 실행 필요)
POST {{baseUrl}}/api/members
Content-Type: application/json

{
  "email": "hero@cau.ac.kr",
  "password": "password123!",
  "nickname": "다른닉네임",
  "home_name": "우리집",
  "home_address": "서울특별시 동작구 흑석로 84",
  "home_lat": 37.50490,
  "home_lng": 126.96147,
  "preparation_time": 10
}

