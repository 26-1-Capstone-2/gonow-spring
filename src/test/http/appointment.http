### ================================================================
### appointment.http — 그룹 알람 API 테스트
### 매 테스트 전 서버를 재기동(DB create)하여 초기화할 것
### 방장(host)과 참여자(guest) 2명의 계정을 모두 생성하여 테스트
### ================================================================


### ================================================================
### STEP 1. 방장 계정 회원가입 + 로그인
### ================================================================

### 1-1. 방장 회원가입
POST {{baseUrl}}/api/members
Content-Type: application/json

{
  "email": "host@cau.ac.kr",
  "password": "password123!",
  "nickname": "방장",
  "home_name": "우리집",
  "home_address": "서울특별시 동작구 흑석로 84",
  "home_lat": 37.50490,
  "home_lng": 126.96147,
  "preparation_time": 10
}

### 1-2. 방장 로그인 → hostToken 저장
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "host@cau.ac.kr",
  "password": "password123!"
}

> {%
    client.global.set("hostToken", response.body.data.access_token);
    client.global.set("accessToken", response.body.data.access_token);
%}


### ================================================================
### STEP 2. 참여자 계정 회원가입 + 로그인
### ================================================================

### 2-1. 참여자 회원가입
POST {{baseUrl}}/api/members
Content-Type: application/json

{
  "email": "guest@cau.ac.kr",
  "password": "password123!",
  "nickname": "참여자",
  "home_name": "자취방",
  "home_address": "서울특별시 마포구 양화로 160",
  "home_lat": 37.55763,
  "home_lng": 126.92525,
  "preparation_time": 15
}

### 2-2. 참여자 로그인 → guestToken 저장
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "guest@cau.ac.kr",
  "password": "password123!"
}

> {%
    client.global.set("guestToken", response.body.data.access_token);
%}


### ================================================================
### STEP 3. 그룹 알람 생성 (방장)
### ================================================================

### 3. 그룹 알람 생성 → 200 { data: { appointment_id, invite_code } }
# 응답의 invite_code를 STEP 4에서 사용
POST {{baseUrl}}/api/appointments
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{
  "title": "면접 스터디",
  "plan_date": "2026-12-31",
  "target_time": "2026-12-31T19:00:00",
  "dest_name": "홍대입구역 2번 출구",
  "dest_address": "서울특별시 마포구 양화로 160",
  "dest_lat": 37.55763,
  "dest_lng": 126.92525,
  "transport_type": "TRANSIT"
}


### ================================================================
### STEP 4. 초대코드로 참여 (참여자)
### ================================================================

### 4. 초대코드로 참여 → 200 { data: { appointment_id } }
# invite_code는 STEP 3 응답값으로 교체
POST {{baseUrl}}/api/appointments/join
Content-Type: application/json
Authorization: Bearer {{guestToken}}

{
  "invite_code": "AB23CD45",
  "transport_type": "DRIVING"
}


### ================================================================
### STEP 5. 그룹 알람 조회
### ================================================================

### 5-1. 그룹 알람 상세 조회 (방장) → 200 { data: { appointment_id, title, plan_date, target_time, dest_*, invite_code, appointment_status, participants: [...] } }
# appointment_id는 STEP 3 응답값으로 교체
GET {{baseUrl}}/api/appointments/1
Authorization: Bearer {{hostToken}}

### 5-2. 도착 예정 대시보드 조회 → 200 { data: { target_time, dest_name, participants: [{ nickname, transport_type, estimated_arrival, is_me }] } }
# estimated_arrival은 플라스크 연동 전 null
GET {{baseUrl}}/api/appointments/1/dashboard
Authorization: Bearer {{hostToken}}


### ================================================================
### STEP 6. 그룹 알람 수정 (방장 전용)
### ================================================================

### 6. 그룹 알람 수정 → 200 { data: null }
PATCH {{baseUrl}}/api/appointments/1
Content-Type: application/json
Authorization: Bearer {{hostToken}}

{
  "plan_date": "2026-12-31",
  "target_time": "2026-12-31T19:00:00",
  "dest_name": "홍대입구역 2번 출구",
  "dest_address": "서울특별시 마포구 양화로 160",
  "dest_lat": 37.55763,
  "dest_lng": 126.92525,
  "transport_type": "DRIVING"
}


### ================================================================
### STEP 7. 이동수단 변경 (참여자 전용)
### ================================================================

### 7. 이동수단 변경 → 200 { data: null }
PATCH {{baseUrl}}/api/appointments/1/participants/transport
Content-Type: application/json
Authorization: Bearer {{guestToken}}

{
  "transport_type": "TRANSIT"
}


### ================================================================
### STEP 8. 개인 알람 스위치 ON/OFF
### ================================================================

### 8-1. 개인 알람 OFF → 200 { data: null }
PATCH {{baseUrl}}/api/appointments/1/participants/active
Content-Type: application/json
Authorization: Bearer {{guestToken}}

{
  "is_active": false
}

### 8-2. 개인 알람 ON → 200 { data: null }
PATCH {{baseUrl}}/api/appointments/1/participants/active
Content-Type: application/json
Authorization: Bearer {{guestToken}}

{
  "is_active": true
}


### ================================================================
### STEP 9. 참여자 탈퇴 & 추방
### ================================================================

### 9-1. 참여자 본인 탈퇴 → 200 { data: null }
# targetMemberId = 참여자 본인 member_id (2번)
DELETE {{baseUrl}}/api/appointments/1/participants/2
Authorization: Bearer {{guestToken}}

### 9-2. 방장이 참여자 추방 → 200 { data: null }
# targetMemberId = 추방할 참여자의 member_id (2번)
DELETE {{baseUrl}}/api/appointments/1/participants/2
Authorization: Bearer {{hostToken}}


### ================================================================
### STEP 10. 그룹 알람 삭제 (방장 전용)
### ================================================================

### 10. 그룹 알람 삭제 → 200 { data: null }
# Appointment + 모든 Participant 일괄 삭제
DELETE {{baseUrl}}/api/appointments/1
Authorization: Bearer {{hostToken}}
